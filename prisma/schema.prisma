// Youth Desk — Municipal Assembly youth affairs system.
// Single office, private database. Officer-side case queue + youth register;
// public report/track pages. Case numbers are permanent references (YD-YYYY-NNNN).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Officer {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String // bcrypt hash
  fullName  String
  role      String   @default("OFFICER") // OFFICER | ADMIN
  createdAt DateTime @default(now())
}

model Area {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Youth {
  id         Int      @id @default(autoincrement())
  serial     String   @unique
  name       String
  phone      String?
  area       String?
  dateOfBirth String?
  education  String?
  skills     String?
  ghanaCard  String?
  source     String @default("WALKIN")
  createdAt  DateTime @default(now())
  cases      Case[]
}

model Case {
  id           Int         @id @default(autoincrement())
  caseNumber   String      @unique
  reporterName String? // may be anonymised
  phone        String? // optional callback
  area         String?
  type         String // EMPLOYMENT | TRAINING | GRIEVANCE | FINANCE | HEALTH | EDUCATION | SENSITIVE | OTHER
  description  String
  status       String      @default("NEW") // NEW | IN_PROGRESS | RESOLVED | FORWARDED
  forwardedTo  String?
  resolution   String? // the officer's resolution text - the client reads it on the tracking page
  youthId      Int? // links a walk-in youth account
  youth        Youth?     @relation(fields: [youthId], references: [id])
  trackKey     String?     @unique // private tracking key: number alone cannot open the case
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  notes        CaseNote[]
  attachments  Attachment[]

  @@index([status, createdAt])
}
// Evidence files (photos/documents) attached by the youth or the officer.
// Bytes live in this database - no external bucket - so uploads stay sealed.
model Attachment {
  id        Int      @id @default(autoincrement())
  caseId    Int
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseNote {
  id        Int      @id @default(autoincrement())
  caseId    Int
  body      String
  author    String
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}


// Municipality youth interventions / programmes the desk coordinates and
// monitors (Trip-Report mandate: track municipal KPIs on commitments and
// interventions towards young people). Feeds the Management report KPI table.
model Intervention {
  id         Int      @id @default(autoincrement())
  date       DateTime @db.Date // when it happened / the reference date
  department String // leading department (e.g. Social Welfare, NYA, Agric...)
  title      String
  type       String   @default("TRAINING") // TRAINING | APPRENTICESHIP | INTERNSHIP | MENTORSHIP | GRANT | MARKET | OTHER
  target     Int      @default(0) // planned number of young people
  reached    Int      @default(0) // actual young people reached
  budget     Float?   // optional: amount committed (GHS)
  note       String?
  officer    String // username of the recording officer
  createdAt  DateTime @default(now())
  programs   Program[] // open sign-up posts created from (or linked to) this intervention

  @@index([date])
}

model Program {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  category    String @default("TRAINING") // TRAINING | APPRENTICESHIP | INTERNSHIP | MENTORSHIP | GRANT | MARKET | OTHER
  deadline    String?
  status      String   @default("OPEN") // OPEN | CLOSED (CLOSED = registration closed)
  venue       String?  // where / how to take part
  seats       Int?     // planned participants (null = not stated)
  meetingDate String?  // the scheduled meeting/starting date announced to registrants
  postedBy    String   // officer username
  interventionId Int?  // when this post came from a KPI intervention row
  intervention   Intervention? @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  registrations Registration[]

  @@index([status])
}

// A youth signing up for an open programme. Money NEVER flows - this is an
// interest/attendance registration so the desk can reach youth who cannot
// walk to the office, and it feeds the KPI "reached" evidence.
model Registration {
  id        Int      @id @default(autoincrement())
  programId Int
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  area      String?
  note           String?
  walkin         Boolean  @default(false) // true = registered by the officer at the desk
  createdAt      DateTime @default(now())
  reminderSentAt DateTime? // set when the meeting-reminder SMS went to THIS registrant

  @@unique([programId, phone])
  @@index([programId])
}

// Officer-managed public content (no-code appearance editor).
model SiteImage {
  id        Int      @id @default(autoincrement())
  slot      String   // "hero" (homepage slideshow) | "about" (About gallery)
  mimeType  String
  size      Int
  sort      Int      @default(0)
  data      Bytes
  createdAt DateTime @default(now())

  @@index([slot])
}

model SiteItem {
  id          Int      @id @default(autoincrement())
  kind        String   // "department" | "service"
  title       String
  body        String
  createdAt   DateTime @default(now())
}

// Single row (id = 1) driving the whole public color scheme.
model SiteTheme {
  id      Int    @id @default(1)
  primary String // top bar, buttons, landing band
  accent  String // highlights (active tab underline, accents)
}

// Editable words of the public site (keyed lines; code holds the defaults).
model SiteText {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model SmsLog {
  id          Int      @id @default(autoincrement())
  kind        String   // CASE_CONFIRM
  phone       String
  caseNumber  String?
  status      String   // SENT | FAILED | SKIPPED
  providerRef String?
  error       String?
  createdAt   DateTime @default(now())
}

// Server-side monotonic counters (serial-retire law: numbers are permanent
// references once delivered on a slip or by SMS - never reissued).
model Counter {
  key String @id
  n   Int    @default(0)
}

// Municipal news posted by the officer; shown on the main page (latest 3 cards
// + the scrolling newsflash ticker). Images live in this database too.
model News {
  id        Int         @id @default(autoincrement())
  title     String // <=120
  body      String // <=4000
  author    String // officer username
  important Boolean     @default(false) // important announcements scroll in the newsflash ticker
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  images    NewsImage[]

  @@index([createdAt])
}

model NewsImage {
  id       Int    @id @default(autoincrement())
  newsId   Int
  mimeType String
  size     Int
  sort     Int    @default(0)
  data     Bytes
  news     News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@index([newsId])
}
